    "import random\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "def generate_pengiriman(total):\n",
    "    kota = [\"Jakarta\", \"Bandung\", \"Surabaya\", \"Semarang\", \"Yogyakarta\"]\n",
    "    layanan = [\"Reguler\", \"Express\", \"Same Day\"]\n",
    "    status = [\"Dikirim\", \"Dalam Perjalanan\", \"Tiba di Hub\"]\n",
    "    kurir_list = [\"JNE\", \"J&T\", \"SiCepat\", \"AnterAja\", \"Ninja\"]\n",
    "\n",
    "    base_date = datetime(2026, 2, 1, 8, 0, 0) \n",
    "    data = []\n",
    "\n",
    "    for i in range(total):\n",
    "        random_seconds = random.randint(0, 5*24*60*60)\n",
    "        waktu_pengiriman = base_date + timedelta(seconds=random_seconds)\n",
    "\n",
    "        data.append({\n",
    "            \"id_paket\": f\"PKT{i+1:05}\",\n",
    "            \"kurir\": random.choice(kurir_list),\n",
    "            \"asal\": random.choice(kota),\n",
    "            \"tujuan\": random.choice(kota),\n",
    "            \"jenis_layanan\": random.choice(layanan),\n",
    "            \"status_pengiriman\": random.choice(status),\n",
    "            \"waktu_pengiriman\": waktu_pengiriman.strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "        })\n",
    "\n",
    "    return data\n",
    "\n",
    "pd.set_option(\"display.max_rows\", None)\n",
    "pd.set_option(\"display.max_columns\", None)\n",
    "pd.set_option(\"display.width\", 200) "
   ]
