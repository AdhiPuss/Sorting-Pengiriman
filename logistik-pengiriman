    "def bubble_sort_iterative(data):\n",
    "    n = len(data)\n",
    "    for i in range(n):\n",
    "        for j in range(0, n - i - 1):\n",
    "            if data[j][\"waktu_pengiriman\"] > data[j + 1][\"waktu_pengiriman\"]:\n",
    "                data[j], data[j + 1] = data[j + 1], data[j]\n",
    "                \n",
    "def bubble_sort_recursive(data, n=None):\n",
    "    if n is None:\n",
    "        n = len(data)\n",
    "    if n <= 1:\n",
    "        return\n",
    "    for i in range(n - 1):\n",
    "        if data[i][\"waktu_pengiriman\"] > data[i + 1][\"waktu_pengiriman\"]:\n",
    "            data[i], data[i + 1] = data[i + 1], data[i]\n",
    "    bubble_sort_recursive(data, n - 1)\n",
    "\n",
    "def merge_sort_recursive(data):\n",
    "    if len(data) <= 1:\n",
    "        return data\n",
    "    mid = len(data) // 2\n",
    "    left = merge_sort_recursive(data[:mid])\n",
    "    right = merge_sort_recursive(data[mid:])\n",
    "    result = []\n",
    "    i = j = 0\n",
    "    while i < len(left) and j < len(right):\n",
    "        if left[i][\"waktu_pengiriman\"] <= right[j][\"waktu_pengiriman\"]:\n",
    "            result.append(left[i]); i += 1\n",
    "        else:\n",
    "            result.append(right[j]); j += 1\n",
    "    result.extend(left[i:])\n",
    "    result.extend(right[j:])\n",
    "    return result\n",
    "\n",
    "def merge_sort_iterative(data):\n",
    "    width = 1\n",
    "    n = len(data)\n",
    "    result = data.copy()\n",
    "\n",
    "    while width < n:\n",
    "        for i in range(0, n, 2 * width):\n",
    "            left = result[i:i + width]\n",
    "            right = result[i + width:i + 2 * width]\n",
    "            merged = merge(left, right)\n",
    "            result[i:i + len(merged)] = merged\n",
    "        width *= 2\n",
    "\n",
    "    return result\n",
    "\n",
    "def merge(left, right):\n",
    "    result = []\n",
    "    i = j = 0\n",
